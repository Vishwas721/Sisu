# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=leads_pipeline
DB_USER=postgres
DB_PASSWORD=your_password_here

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Reword the personalized email templates with Ollama (off by default)
USE_LLM_DRAFTS=false

# Outreach sender (postal address is legally required in US commercial email)
SENDER_NAME=Vishwas
SENDER_ADDRESS=

# Discovery (optional). Enables Google Places alongside OpenStreetMap.
# Needs "Places API (New)" enabled in Google Cloud; billed per request.
GOOGLE_PLACES_API_KEY=

# Most new leads saved per day across all runs (0 = no limit)
DAILY_LEAD_CAP=30

# Scraper Settings
PLAYWRIGHT_HEADLESS=true
PAGE_TIMEOUT_MS=30000
